DATAFORGE_DATA_DIR=./data
DATAFORGE_DATABASE_URL=sqlite:///./data/dataforge.db
# PostgreSQL alternative (start with docker compose up -d):
# DATAFORGE_DATABASE_URL=postgresql+psycopg://dataforge:localdev@127.0.0.1:5432/dataforge
DATAFORGE_OCR_ENGINE=auto
# auto uses only installed local engines; no model downloads at runtime.
DATAFORGE_TESSERACT_CMD=
DATAFORGE_PADDLE_DET_DIR=
DATAFORGE_PADDLE_REC_DIR=
DATAFORGE_MAX_SAMPLES=2000
DATAFORGE_MIN_AVAILABLE_MB=1500
# Optional local text model. Runtime never pulls weights or calls cloud endpoints.
DATAFORGE_OLLAMA_URL=http://127.0.0.1:11434
DATAFORGE_OLLAMA_MODEL=qwen3:1.7b
DATAFORGE_LLM_TIMEOUT_SECONDS=180
DATAFORGE_TEXT_MAX_SAMPLES=2000
DATAFORGE_LLM_MIN_AVAILABLE_MB=4000
# Optional portrait download, OFF by default. Fixed operator-approved image URL only.
# No template, OCR text or rule prompt is sent to this provider.
DATAFORGE_ALLOW_ONLINE_PORTRAITS=false
DATAFORGE_PORTRAIT_PROVIDER_URL=
